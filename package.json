{
    "name": "trainedge-investech",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "start": "npm start --prefix backend",
        "build": "npm install --prefix backend && npm install --prefix client --include=dev && npm run build --prefix client",
        "dev:backend": "npm run start --prefix backend",
        "dev:client": "npm run dev --prefix client",
        "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"yellow,cyan\" \"npm run dev:backend\" \"npm run dev:client\""
    },
    "dependencies": {
        "concurrently": "^10.0.5"
    }
}
